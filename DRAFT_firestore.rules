rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { 
      return isSignedIn() && (
        getUserData().role in ['SUPER_ADMIN', 'MD', 'ADMIN', 'ACADEMIC_ADMIN'] ||
        request.auth.token.email == 'swanayamediaenterprisesadmins@gmail.com'
      );
    }
    function isStudent() { return isSignedIn() && getUserData().role == 'STUDENT'; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().role == 'STUDENT';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl'])) ||
        isAdmin()
      );
    }

    // --- Exams ---
    function isValidExam(data) {
      return data.id is string && data.title is string && data.title.size() <= 200 &&
             data.category in ["Weekly Assessment", "Monthly Examination", "Practical Examination", "Final Examination", "Model Examination", "Certification Examination"] &&
             data.status in ["SCHEDULED", "LIVE", "COMPLETED"];
    }

    match /exams/{examId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidExam(incoming());
      allow update: if isAdmin() && isValidExam(incoming());
      allow delete: if isAdmin();

      match /sensitive/data {
        allow read, write: if isAdmin();
      }

      match /questions/{questionId} {
        allow read: if isSignedIn() && (isAdmin() || get(/databases/$(database)/documents/exams/$(examId)).data.status == 'LIVE');
        allow write: if isAdmin();
      }
    }

    // --- Exam Results ---
    function isValidResult(data) {
      return data.examId is string && data.studentId is string && data.status in ["PENDING", "PUBLISHED"];
    }

    match /results/{resultId} {
      allow get: if isSignedIn() && (isAdmin() || existing().studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid && isValidResult(incoming());
      allow update: if isAdmin() && isValidResult(incoming());
      allow delete: if isAdmin();
    }

    // --- Certificates ---
    match /certificates/{certId} {
      allow get: if isSignedIn() && (isAdmin() || existing().studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    // --- Assignments ---
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
