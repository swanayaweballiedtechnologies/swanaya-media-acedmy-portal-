      "description": "Examination sessions."
    },
    "/exam_registrations/{regId}": {
      "schema": "ExamRegistration",
      "description": "Student examination registrations."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Course and academy reviews."
    },
    "/exam_question_papers/{paperId}": {
