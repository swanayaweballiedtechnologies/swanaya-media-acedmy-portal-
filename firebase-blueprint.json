  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Academy courses."
    },
    "/blogs/{id}": {
      "schema": "Blog",
      "description": "Blog posts and articles."
    },
    "/media_assets/{id}": {
      "schema": "MediaAsset",
      "description": "Media files."
    },
    "/registrations/{id}": {
      "schema": "Registration",
      "description": "Course registrations."
    },
    "/library_posts/{id}": {
