             data.keys().hasOnly([
               'id', 'invoiceNumber', 'invoiceId', 'studentId', 'userId', 'studentName', 'studentEmail',
               'courseId', 'courseName', 'amount', 'currency', 'paymentMethod', 'upiIdPaidTo',
               'utrNumber', 'upiAppName', 'gatewayOrderId', 'gatewayPaymentId', 'gatewaySignatureVerified',
               'proofNote', 'status', 'receiptNumber', 'verifiedBy', 'verifiedById', 'verifiedAt',
               'rejectionReason', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 64 &&
             data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
             data.currency == 'INR' &&
             data.paymentMethod in ['GPAY_UPI', 'UPI_QR', 'UPI_INTENT', 'RAZORPAY_UPI', 'BANK_TRANSFER'] &&
             data.status in ['AWAITING_PAYMENT', 'PENDING_VERIFICATION', 'VERIFIED', 'REJECTED'];
    }

    function isValidGoogleMeetMeeting(data) {
      return data.keys().hasAll(['id', 'title', 'courseId', 'startTime', 'endTime', 'meetLink', 'organizerEmail', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'id', 'calendarEventId', 'title', 'description', 'courseId', 'courseName',
               'batchId', 'batchName', 'instructorId', 'instructorName', 'instructorEmail',
               'startTime', 'endTime', 'meetLink', 'organizerEmail', 'organizerName',
               'attendeeEmails', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             (!('calendarEventId' in data) || (data.calendarEventId is string && data.calendarEventId.size() <= 200)) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 4000)) &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128 &&
             (!('courseName' in data) || (data.courseName is string && data.courseName.size() <= 240)) &&
             (!('batchId' in data) || (data.batchId is string && data.batchId.size() <= 128)) &&
             (!('batchName' in data) || (data.batchName is string && data.batchName.size() <= 160)) &&
             (!('instructorId' in data) || (data.instructorId is string && data.instructorId.size() <= 128)) &&
             (!('instructorName' in data) || (data.instructorName is string && data.instructorName.size() <= 150)) &&
             (!('instructorEmail' in data) || (data.instructorEmail is string && data.instructorEmail.size() <= 200)) &&
             data.startTime is string && data.startTime.size() > 0 && data.startTime.size() <= 64 &&
             data.endTime is string && data.endTime.size() > 0 && data.endTime.size() <= 64 &&
             data.meetLink is string && data.meetLink.size() > 0 && data.meetLink.size() <= 512 && data.meetLink.matches('^https://.*') &&
             data.organizerEmail is string && data.organizerEmail.size() > 0 && data.organizerEmail.size() <= 200 &&
             (!('organizerName' in data) || (data.organizerName is string && data.organizerName.size() <= 150)) &&
             (!('attendeeEmails' in data) || (data.attendeeEmails is list && data.attendeeEmails.size() <= 200)) &&
             data.status in ['SCHEDULED', 'RESCHEDULED', 'CANCELLED'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.id == request.auth.uid);
      allow create: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        isMd() ||
        (isOwner(userId) && incoming().role in ['STUDENT', 'INSTRUCTOR', 'ALUMNI', 'PARENT']) ||
        (isOwner(userId) && isVerified() && ('email' in request.auth.token) && request.auth.token.email is string &&
          incoming().role in ['ADMIN', 'ACADEMIC_ADMIN'] &&
          'grantId' in incoming() && isValidId(incoming().grantId) &&
          exists(/databases/$(database)/documents/admin_grants/$(incoming().grantId)) &&
          get(/databases/$(database)/documents/admin_grants/$(incoming().grantId)).data.email == request.auth.token.email.lower() &&
          get(/databases/$(database)/documents/admin_grants/$(incoming().grantId)).data.status == 'ACTIVE' &&
          get(/databases/$(database)/documents/admin_grants/$(incoming().grantId)).data.role == incoming().role)
      );
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        isMd() ||
        (isOwner(userId) && incoming().role == existing().role && incoming().id == existing().id) ||
        (isOwner(userId) && isVerified() && ('email' in request.auth.token) && request.auth.token.email is string &&
          incoming().role in ['ADMIN', 'ACADEMIC_ADMIN'] &&
          'grantId' in incoming() && isValidId(incoming().grantId) &&
          exists(/databases/$(database)/documents/admin_grants/$(incoming().grantId)) &&
          get(/databases/$(database)/documents/admin_grants/$(incoming().grantId)).data.email == request.auth.token.email.lower() &&
          get(/databases/$(database)/documents/admin_grants/$(incoming().grantId)).data.status == 'ACTIVE' &&
          get(/databases/$(database)/documents/admin_grants/$(incoming().grantId)).data.role == incoming().role)
      );
      allow delete: if isValidId(userId) && isMd() && userId != request.auth.uid;
    }

    match /admin_grants/{grantId} {
      allow get: if isValidId(grantId) && isSignedIn() && (isMd() || (isVerified() && ('email' in request.auth.token) && request.auth.token.email is string && resource.data.email == request.auth.token.email.lower()));
      allow list: if isSignedIn() && (isMd() || (isVerified() && ('email' in request.auth.token) && request.auth.token.email is string && resource.data.email == request.auth.token.email.lower() && resource.data.status == 'ACTIVE'));
      allow create: if isValidId(grantId) && isMd() && isValidAdminGrant(incoming()) && incoming().grantedByUid == request.auth.uid;
      allow update: if isValidId(grantId) && isMd() && isValidAdminGrant(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(grantId) && isMd();
    }

    match /blogs/{blogId} {
      allow read: if (resource.data.status == 'PUBLISHED' || isAdmin() || isOwner(resource.data.authorId));
      allow list: if (resource.data.status == 'PUBLISHED' || isAdmin() || isOwner(resource.data.authorId));
      allow create: if isSignedIn() && isValidId(blogId) && isValidBlog(incoming()) && (
        isAdmin() || !('isFeatured' in incoming()) || incoming().isFeatured == false
      );
      allow update: if isValidId(blogId) && (isAdmin() || isOwner(existing().authorId)) && isValidBlog(incoming()) && (
        incoming().authorId == existing().authorId &&
        (isAdmin() || !('isFeatured' in incoming()) || incoming().isFeatured == false)
      );
      allow delete: if isValidId(blogId) && (isAdmin() || isOwner(existing().authorId));
    }

    match /media_assets/{assetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMediaAsset(incoming());
      allow delete: if isAdmin() || isOwner(existing().uploadedBy);
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId) && (resource.data.status == 'ACTIVE' || resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.status == 'ACTIVE' || isAdmin();
      allow create, update: if isAdmin() && isValidId(courseId) && isValidCourse(incoming());
      allow delete: if isAdmin() && isValidId(courseId);
    }

    match /course_papers/{paperId} {
      allow get: if isValidId(paperId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.isPublished == true && isEnrolledInCourse(resource.data.courseId))
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.isPublished == true && isEnrolledInCourse(resource.data.courseId)
      );
      allow create: if isAdmin() && isValidId(paperId) && isValidCoursePaper(incoming()) && incoming().uploadedById == request.auth.uid;
      allow update: if isAdmin() && isValidId(paperId) && isValidCoursePaper(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(paperId);
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    match /registrations/{id} {
      allow get: if isSignedIn() && isValidId(id) && (isDepartmentStaff() || resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow list: if isSignedIn() && (isDepartmentStaff() || resource.data.userId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && isValidRegistration(incoming()) && (
        isAdmin() ||
        (incoming().userId == request.auth.uid && incoming().status == 'PENDING' && incoming().departmentVerificationStatus == 'PENDING' && incoming().mdVerificationStatus == 'PENDING_MD')
      );
      allow update: if isSignedIn() && isValidId(id) && isValidRegistration(incoming()) && (
        isAdmin() ||
        (isDepartmentStaff() &&
          incoming().userId == existing().userId &&
          incoming().studentId == existing().studentId &&
          incoming().courseId == existing().courseId &&
          incoming().createdAt == existing().createdAt &&
          incoming().mdVerificationStatus == existing().mdVerificationStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'departmentVerificationStatus', 'departmentVerifiedBy', 'departmentVerifiedRole', 'departmentVerifiedAt', 'departmentRemarks', 'updatedAt']) &&
          incoming().departmentVerificationStatus in ['PENDING', 'VERIFIED', 'RETURNED', 'REJECTED'] &&
          incoming().status in ['PENDING', 'DEPARTMENT_VERIFIED', 'RETURNED', 'REJECTED'])
      );
      allow delete: if isAdmin() && isValidId(id);
    }

    match /library_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.courseId == 'ALL');
      allow write: if isAdmin();
    }

    match /audit_ledger/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /exam_sessions/{sessionId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(sessionId) && isValidExamSession(incoming());
      allow update: if isAdmin() && isValidId(sessionId) && isValidExamSession(incoming());
      allow delete: if isAdmin() && isValidId(sessionId);
    }

    match /exam_registrations/{regId} {
      allow get: if isSignedIn() && isValidId(regId) && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(regId) && isValidExamRegistration(incoming()) && incoming().userId == request.auth.uid && incoming().status == 'PENDING';
      allow update: if isAdmin() && isValidId(regId) && isValidExamRegistration(incoming());
      allow delete: if isAdmin() && isValidId(regId);
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (resource.data.status == 'PUBLISHED' || isOwner(resource.data.authorId) || isAdmin());
      allow list: if resource.data.status == 'PUBLISHED' || (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && incoming().authorId == request.auth.uid && incoming().status == 'PUBLISHED' && (!('helpfulCount' in incoming()) || incoming().helpfulCount == 0);
      allow update: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && (
        isAdmin() ||
        (isOwner(existing().authorId) && incoming().authorId == existing().authorId && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'title', 'comment', 'courseId', 'courseName', 'updatedAt'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount', 'updatedAt']) && incoming().helpfulCount == existing().helpfulCount + 1)
      );
      allow delete: if isSignedIn() && isValidId(reviewId) && (isAdmin() || isOwner(existing().authorId));
    }

    match /exam_question_papers/{paperId} {
      allow get: if isSignedIn() && isValidId(paperId) && (resource.data.mdVerificationStatus == 'VERIFIED' || isInstructorOrAdmin() || resource.data.createdById == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.mdVerificationStatus == 'VERIFIED' || isInstructorOrAdmin() || resource.data.createdById == request.auth.uid);
      allow create: if isSignedIn() && isValidId(paperId) && isValidQuestionPaper(incoming()) && isInstructorOrAdmin() && incoming().createdById == request.auth.uid && (isAdmin() || incoming().mdVerificationStatus == 'PENDING_MD');
      allow update: if isSignedIn() && isValidId(paperId) && isValidQuestionPaper(incoming()) && (
        isAdmin() ||
        (isInstructorOrAdmin() && existing().createdById == request.auth.uid && incoming().createdById == existing().createdById && incoming().createdAt == existing().createdAt && incoming().mdVerificationStatus == 'PENDING_MD')
      );
      allow delete: if isSignedIn() && isValidId(paperId) && (isAdmin() || (isInstructorOrAdmin() && existing().createdById == request.auth.uid));
    }

    match /mcq_exams/{examId} {
      allow get: if isSignedIn() && isValidId(examId) && (resource.data.mdVerificationStatus == 'VERIFIED' || isInstructorOrAdmin() || resource.data.createdById == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.mdVerificationStatus == 'VERIFIED' || isInstructorOrAdmin() || resource.data.createdById == request.auth.uid);
      allow create: if isSignedIn() && isValidId(examId) && isValidMcqExam(incoming()) && isInstructorOrAdmin() && incoming().createdById == request.auth.uid && (isAdmin() || incoming().mdVerificationStatus == 'PENDING_MD');
      allow update: if isSignedIn() && isValidId(examId) && isValidMcqExam(incoming()) && (
        isAdmin() ||
        (isInstructorOrAdmin() && existing().createdById == request.auth.uid && incoming().createdById == existing().createdById && incoming().createdAt == existing().createdAt && incoming().mdVerificationStatus == 'PENDING_MD')
      );
      allow delete: if isSignedIn() && isValidId(examId) && (isAdmin() || (isInstructorOrAdmin() && existing().createdById == request.auth.uid));
    }

    match /exam_submissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (isInstructorOrAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isInstructorOrAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(submissionId) && isValidExamSubmission(incoming()) && incoming().userId == request.auth.uid && incoming().evaluationStatus == 'SUBMITTED';
      allow update: if isSignedIn() && isValidId(submissionId) && isValidExamSubmission(incoming()) && (
        isAdmin() ||
        (isInstructorOrAdmin() && existing().evaluationStatus != 'MD_VERIFIED' && incoming().userId == existing().userId && incoming().submittedAt == existing().submittedAt && incoming().evaluationStatus in ['INSTRUCTOR_EVALUATED', 'RETURNED'])
      );
      allow delete: if isSignedIn() && isValidId(submissionId) && isAdmin();
    }

    match /exam_announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isMdOrPrincipal();
      allow list: if isMdOrPrincipal();
      allow create: if isValidId(announcementId) && isMdOrPrincipal() && isValidExamAnnouncement(incoming()) && incoming().createdById == request.auth.uid;
      allow update: if isValidId(announcementId) && isMdOrPrincipal() && isValidExamAnnouncement(incoming()) && incoming().createdById == existing().createdById && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(announcementId) && isMdOrPrincipal();
    }

    match /site_settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(settingId) && (
        (settingId == 'theme_config' && isValidThemeConfig(incoming())) ||
        (settingId != 'theme_config' && isValidFrontPageConfig(incoming()))
      );
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /attendance_qr_sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(sessionId) && isInstructorOrAdmin() && isValidAttendanceQrSession(incoming());
      allow update: if isValidId(sessionId) && isInstructorOrAdmin() && isValidAttendanceQrSession(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(sessionId) && isInstructorOrAdmin();
    }

    match /attendance_checkins/{checkinId} {
      allow get: if isValidId(checkinId) && isSignedIn() && (isInstructorOrAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isInstructorOrAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(checkinId) && isSignedIn() && isValidAttendanceCheckIn(incoming()) && (
        isInstructorOrAdmin() || incoming().userId == request.auth.uid
      );
      allow update, delete: if isValidId(checkinId) && isInstructorOrAdmin();
    }

    match /class_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (resource.data.isActive == true || isInstructorOrAdmin());
      allow list: if isSignedIn() && (resource.data.isActive == true || isInstructorOrAdmin());
      allow create: if isValidId(sessionId) && isInstructorOrAdmin() && isValidClassSession(incoming()) && incoming().createdById == request.auth.uid;
      allow update: if isValidId(sessionId) && isInstructorOrAdmin() && isValidClassSession(incoming()) && incoming().createdById == existing().createdById && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(sessionId) && isInstructorOrAdmin();
    }

    match /fee_payments/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (isFinanceOrAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isFinanceOrAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(txId) && isSignedIn() && isValidFeePayment(incoming()) && (
        isFinanceOrAdmin() ||
        (incoming().userId == request.auth.uid && incoming().status == 'AWAITING_PAYMENT' && !('receiptNumber' in incoming()) && !('verifiedBy' in incoming()))
      );
      allow update: if isValidId(txId) && isSignedIn() && isValidFeePayment(incoming()) && (
        isFinanceOrAdmin() ||
        (existing().userId == request.auth.uid &&
         existing().status != 'VERIFIED' &&
         incoming().userId == existing().userId &&
         incoming().amount == existing().amount &&
         incoming().invoiceNumber == existing().invoiceNumber &&
         incoming().status == 'PENDING_VERIFICATION' &&
         !('receiptNumber' in incoming()) &&
         !('verifiedBy' in incoming()))
      );
      allow delete: if isValidId(txId) && isFinanceOrAdmin();
    }

    match /google_meet_meetings/{meetingId} {
      allow get: if isValidId(meetingId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(meetingId) && isInstructorOrAdmin() && isValidGoogleMeetMeeting(incoming());
      allow update: if isValidId(meetingId) && isInstructorOrAdmin() && isValidGoogleMeetMeeting(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(meetingId) && isInstructorOrAdmin();
    }

    match /course_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    match /course_modules/{moduleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(moduleId);
    }

    match /course_credits/{creditId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(creditId);
    }

    match /tutor_course_allocations/{allocationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(allocationId);
    }

    match /student_course_selections/{selectionId} {
      allow get: if isValidId(selectionId) && isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid || isInstructor());
      allow list: if isSignedIn() && (isAdmin() || isInstructor() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(selectionId) && isSignedIn() && isValidStudentCourseSelection(incoming()) && (
        isAdmin() || (incoming().userId == request.auth.uid && incoming().approvalStatus in ['DRAFT', 'SUBMITTED'])
      );
      allow update: if isValidId(selectionId) && isSignedIn() && isValidStudentCourseSelection(incoming()) && (
        isAdmin() || (
          existing().userId == request.auth.uid &&
          existing().approvalStatus != 'APPROVED' &&
          incoming().userId == existing().userId &&
          incoming().approvalStatus in ['DRAFT', 'SUBMITTED']
        )
      );
      allow delete: if isAdmin() && isValidId(selectionId);
    }

    match /course_enrollments/{enrollmentId} {
      allow get: if isValidId(enrollmentId) && isSignedIn() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || isInstructor() || resource.data.studentId == request.auth.uid);
      allow create, update, delete: if isAdmin() && isValidId(enrollmentId);
    }

    match /course_approval_logs/{logId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.actorId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(logId) && (isAdmin() || request.resource.data.actorId == request.auth.uid);
      allow update, delete: if false;
    }

    match /tutor_progress_reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (isInstructorOrAdmin() || resource.data.studentId == request.auth.uid);
      allow list: if isSignedIn() && (isInstructorOrAdmin() || resource.data.studentId == request.auth.uid);
      allow create: if isValidId(reportId) && isSignedIn() && isInstructorOrAdmin() && isValidTutorProgressReport(incoming());
      allow update: if isValidId(reportId) && isSignedIn() && isInstructorOrAdmin() && isValidTutorProgressReport(incoming()) && (isAdmin() || existing().tutorId == request.auth.uid);
      allow delete: if isAdmin() && isValidId(reportId);
    }
  }
}
