rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Primitives ---
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Admin check - lookup role in users collection safely
    function isAdminEmail() {
      return isSignedIn() &&
             request.auth.token.email_verified == true && (
               request.auth.token.email == 'swanayamediaenterprisesadmins@gmail.com' ||
               request.auth.token.email == 'swanyamediaenterprisesadmins@gmail.com' ||
               request.auth.token.email == 'aadithyan@swanayamedia.com' ||
               request.auth.token.email == 'aadithyan.menon@swanayamedia.com' ||
               request.auth.token.email == 'aadithyanmmenon@gmail.com'
             );
    }

    function isAdmin() { 
      return isSignedIn() && (
        isAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MD', 'PRINCIPAL', 'ADMIN', 'SUPER_ADMIN', 'ACADEMIC_ADMIN'] &&
         (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'INACTIVE'))
      );
    }

    function isMd() {
      return isSignedIn() && (
        isAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MD', 'SUPER_ADMIN'])
      );
    }

    function isEnrolledInCourse(courseId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.courseId == courseId) ||
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.preferredCourseId == courseId) ||
               ('enrolledCourseIds' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds is list &&
                courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds)
             );
    }

    function isMdOrPrincipal() {
      return isSignedIn() && (
        isAdminEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['MD', 'PRINCIPAL', 'SUPER_ADMIN'])
      );
    }

    function isInstructorOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['INSTRUCTOR', 'REVIEWER'])
      );
    }

    function isDepartmentStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['INSTRUCTOR', 'REVIEWER', 'COUNSELLOR'])
      );
    }

    function isFinanceOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'FINANCE')
      );
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.keys().hasOnly([
               'id', 'name', 'designation', 'email', 'role', 'avatarUrl', 'avatarFocus',
               'phone', 'whatsappPhone', 'guardianName', 'guardianPhone',
               'academicBackground', 'skills', 'bio', 'status', 'createdAt', 'updatedAt',
               'username', 'isVerified', 'email_verified', 'emailVerifiedAt',
               'tutorApprovalStatus', 'adminAcceptanceStatus',
               'whatsappOptIn', 'preferredCourseId', 'courseId',
               'enrolledCourseIds', 'studentIds', 'guardianPin', 'grantId'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('designation' in data) || (data.designation is string && data.designation.size() <= 120)) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.role is string && data.role in ['MD', 'PRINCIPAL', 'STUDENT', 'ADMIN', 'ACADEMIC_ADMIN', 'INSTRUCTOR', 'ALUMNI', 'REVIEWER', 'FINANCE', 'COUNSELLOR', 'CAREER', 'PARENT', 'SUPER_ADMIN'] &&
             (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('email_verified' in data) || data.email_verified is bool) &&
             (!('emailVerifiedAt' in data) || (data.emailVerifiedAt is string && data.emailVerifiedAt.size() <= 64)) &&
             (!('tutorApprovalStatus' in data) || data.tutorApprovalStatus in ['PENDING_APPROVAL', 'APPROVED', 'REJECTED']) &&
             (!('adminAcceptanceStatus' in data) || data.adminAcceptanceStatus in ['PENDING_ACCEPTANCE', 'ACCEPTED', 'DECLINED']) &&
             (!('whatsappOptIn' in data) || data.whatsappOptIn is bool) &&
             (!('preferredCourseId' in data) || (data.preferredCourseId is string && data.preferredCourseId.size() <= 128)) &&
             (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
             (!('enrolledCourseIds' in data) || (data.enrolledCourseIds is list && data.enrolledCourseIds.size() <= 30)) &&
             (!('studentIds' in data) || (data.studentIds is list && data.studentIds.size() <= 20)) &&
             (!('guardianPin' in data) || (data.guardianPin is string && data.guardianPin.size() <= 20)) &&
             (!('grantId' in data) || (data.grantId is string && data.grantId.size() <= 128)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000)) &&
             (!('avatarFocus' in data) || data.avatarFocus in ['center', 'top']) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
             (!('whatsappPhone' in data) || (data.whatsappPhone is string && data.whatsappPhone.size() <= 64)) &&
             (!('guardianName' in data) || (data.guardianName is string && data.guardianName.size() <= 150)) &&
             (!('guardianPhone' in data) || (data.guardianPhone is string && data.guardianPhone.size() <= 64)) &&
             (!('academicBackground' in data) || (data.academicBackground is string && data.academicBackground.size() <= 300)) &&
             (!('skills' in data) || (data.skills is list && data.skills.size() <= 25)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 40)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAdminGrant(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'status', 'grantedByUid', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'email', 'username', 'name', 'role', 'phone', 'status', 'grantedByUid', 'grantedByName', 'grantedByEmail', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.role in ['ADMIN', 'ACADEMIC_ADMIN'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
             data.status in ['ACTIVE', 'INACTIVE'] &&
             data.grantedByUid is string && data.grantedByUid.size() > 0 && data.grantedByUid.size() <= 128 &&
             (!('grantedByName' in data) || (data.grantedByName is string && data.grantedByName.size() <= 200)) &&
             (!('grantedByEmail' in data) || (data.grantedByEmail is string && data.grantedByEmail.size() <= 200)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidBlog(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'authorId', 'status']) &&
             data.keys().hasOnly(['id', 'title', 'slug', 'content', 'excerpt', 'authorId', 'authorName', 'thumbnailUrl', 'category', 'contentType', 'tags', 'status', 'isFeatured', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 1048576 &&
             (!('contentType' in data) || (data.contentType is string && data.contentType.size() <= 64)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
             data.authorId == request.auth.uid &&
             data.status in ['DRAFT', 'PUBLISHED'];
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['id', 'url', 'type', 'uploadedBy']) &&
             data.url is string && data.url.size() <= 2048 &&
             data.type in ['IMAGE', 'VIDEO', 'DOCUMENT'] &&
             data.uploadedBy == request.auth.uid;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['id', 'userId', 'studentId', 'studentName', 'courseId', 'courseTitle', 'status', 'departmentVerificationStatus', 'mdVerificationStatus']) &&
             data.keys().hasOnly([
               'id', 'userId', 'studentId', 'studentName', 'studentEmail', 'studentPhone', 'source',
               'courseId', 'courseCode', 'courseTitle', 'courseCategory', 'answers', 'status',
               'departmentVerificationStatus', 'departmentVerifiedBy', 'departmentVerifiedRole',
               'departmentVerifiedAt', 'departmentRemarks',
               'mdVerificationStatus', 'mdVerifiedBy', 'mdVerifiedAt', 'mdRemarks',
               'captchaVerifiedAt', 'timestamp', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 200 &&
             (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 200)) &&
             (!('studentPhone' in data) || (data.studentPhone is string && data.studentPhone.size() <= 64)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 64)) &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128 &&
             (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 64)) &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 240 &&
             (!('courseCategory' in data) || (data.courseCategory is string && data.courseCategory.size() <= 120)) &&
             (!('answers' in data) || data.answers is map) &&
             data.status in ['PENDING', 'DEPARTMENT_VERIFIED', 'MD_VERIFIED', 'APPROVED', 'RETURNED', 'REJECTED'] &&
             data.departmentVerificationStatus in ['PENDING', 'VERIFIED', 'RETURNED', 'REJECTED'] &&
             (!('departmentVerifiedBy' in data) || (data.departmentVerifiedBy is string && data.departmentVerifiedBy.size() <= 150)) &&
             (!('departmentVerifiedRole' in data) || (data.departmentVerifiedRole is string && data.departmentVerifiedRole.size() <= 64)) &&
             (!('departmentVerifiedAt' in data) || (data.departmentVerifiedAt is string && data.departmentVerifiedAt.size() <= 64)) &&
             (!('departmentRemarks' in data) || (data.departmentRemarks is string && data.departmentRemarks.size() <= 1000)) &&
             data.mdVerificationStatus in ['PENDING_MD', 'VERIFIED', 'REJECTED'] &&
             (!('mdVerifiedBy' in data) || (data.mdVerifiedBy is string && data.mdVerifiedBy.size() <= 150)) &&
             (!('mdVerifiedAt' in data) || (data.mdVerifiedAt is string && data.mdVerifiedAt.size() <= 64)) &&
             (!('mdRemarks' in data) || (data.mdRemarks is string && data.mdRemarks.size() <= 1000)) &&
             (!('captchaVerifiedAt' in data) || (data.captchaVerifiedAt is string && data.captchaVerifiedAt.size() <= 64)) &&
             (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidExamSession(data) {
      return data.keys().hasAll(['id', 'title', 'subjectCode', 'scheduledDate', 'status']) &&
             data.keys().hasOnly(['id', 'title', 'subjectCode', 'subjectName', 'courseId', 'batchId', 'scheduledDate', 'startTime', 'endTime', 'durationMinutes', 'totalMarks', 'passMarks', 'examFee', 'registrationDeadline', 'registrationOpen', 'status', 'venue', 'instructions', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.subjectCode is string && data.subjectCode.size() > 0 && data.subjectCode.size() <= 50 &&
             data.scheduledDate is string && data.scheduledDate.size() <= 32 &&
             data.status in ['SCHEDULED', 'LIVE', 'COMPLETED', 'CANCELLED'];
    }

    function isValidExamRegistration(data) {
      return data.keys().hasAll(['id', 'examSessionId', 'userId', 'studentId', 'studentName', 'status']) &&
             data.keys().hasOnly(['id', 'examSessionId', 'examTitle', 'subjectCode', 'subjectName', 'userId', 'studentId', 'studentName', 'studentEmail', 'studentRegisterNo', 'courseId', 'courseName', 'batchId', 'batchName', 'examCenterId', 'examCenterName', 'registrationDate', 'status', 'hallTicketNo', 'seatNumber', 'rejectionReason', 'approvedBy', 'approvedAt', 'feePaid', 'attendanceEligible', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.examSessionId is string && data.examSessionId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 200 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'courseName', 'rating', 'title', 'comment', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'authorId', 'authorName', 'authorRole', 'courseId', 'courseName', 'rating', 'title', 'comment', 'status', 'verifiedStudent', 'helpfulCount', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 150 &&
             (!('authorRole' in data) || (data.authorRole is string && data.authorRole.size() <= 40)) &&
             (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
             data.courseName is string && data.courseName.size() > 0 && data.courseName.size() <= 200 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000 &&
             data.status in ['PUBLISHED', 'FLAGGED'] &&
             (!('verifiedStudent' in data) || data.verifiedStudent is bool) &&
             (!('helpfulCount' in data) || (data.helpfulCount is number && data.helpfulCount >= 0)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidQuestionPaper(data) {
      return data.keys().hasAll(['id', 'title', 'subjectCode', 'courseName', 'totalMarks', 'passMarks', 'createdById', 'mdVerificationStatus', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'subjectCode', 'subjectName', 'courseId', 'courseName', 'durationMinutes', 'totalMarks', 'passMarks', 'instructions', 'paperContent', 'paperFileName', 'paperFileType', 'paperFileDataUrl', 'createdById', 'createdByName', 'mdVerificationStatus', 'mdVerifiedBy', 'mdVerifiedAt', 'mdRemarks', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
             data.subjectCode is string && data.subjectCode.size() > 0 && data.subjectCode.size() <= 50 &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 200)) &&
             (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
             data.courseName is string && data.courseName.size() > 0 && data.courseName.size() <= 200 &&
             (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 600)) &&
             data.totalMarks is number && data.totalMarks > 0 && data.totalMarks <= 1000 &&
             data.passMarks is number && data.passMarks >= 0 && data.passMarks <= data.totalMarks &&
             (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 5000)) &&
             (!('paperContent' in data) || (data.paperContent is string && data.paperContent.size() <= 100000)) &&
             (!('paperFileName' in data) || (data.paperFileName is string && data.paperFileName.size() <= 260)) &&
             (!('paperFileType' in data) || (data.paperFileType is string && data.paperFileType.size() <= 120)) &&
             (!('paperFileDataUrl' in data) || (data.paperFileDataUrl is string && data.paperFileDataUrl.size() <= 500000)) &&
             data.createdById is string && data.createdById.size() > 0 && data.createdById.size() <= 128 &&
             (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 150)) &&
             data.mdVerificationStatus in ['PENDING_MD', 'VERIFIED', 'REJECTED'] &&
             (!('mdVerifiedBy' in data) || (data.mdVerifiedBy is string && data.mdVerifiedBy.size() <= 150)) &&
             (!('mdVerifiedAt' in data) || (data.mdVerifiedAt is string && data.mdVerifiedAt.size() <= 64)) &&
             (!('mdRemarks' in data) || (data.mdRemarks is string && data.mdRemarks.size() <= 1000)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidMcqExam(data) {
      return data.keys().hasAll(['id', 'title', 'subjectCode', 'courseName', 'durationMinutes', 'totalMarks', 'passMarks', 'questions', 'createdById', 'mdVerificationStatus', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'subjectCode', 'subjectName', 'courseId', 'courseName', 'durationMinutes', 'totalMarks', 'passMarks', 'questions', 'createdById', 'createdByName', 'mdVerificationStatus', 'mdVerifiedBy', 'mdVerifiedAt', 'mdRemarks', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
             data.subjectCode is string && data.subjectCode.size() > 0 && data.subjectCode.size() <= 50 &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 200)) &&
             (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
             data.courseName is string && data.courseName.size() > 0 && data.courseName.size() <= 200 &&
             data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 600 &&
             data.totalMarks is number && data.totalMarks > 0 && data.totalMarks <= 1000 &&
             data.passMarks is number && data.passMarks >= 0 && data.passMarks <= data.totalMarks &&
             data.questions is list && data.questions.size() > 0 && data.questions.size() <= 100 &&
             data.questions[0] is map &&
             data.createdById is string && data.createdById.size() > 0 && data.createdById.size() <= 128 &&
             (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 150)) &&
             data.mdVerificationStatus in ['PENDING_MD', 'VERIFIED', 'REJECTED'] &&
             (!('mdVerifiedBy' in data) || (data.mdVerifiedBy is string && data.mdVerifiedBy.size() <= 150)) &&
             (!('mdVerifiedAt' in data) || (data.mdVerifiedAt is string && data.mdVerifiedAt.size() <= 64)) &&
             (!('mdRemarks' in data) || (data.mdRemarks is string && data.mdRemarks.size() <= 1000)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidExamSubmission(data) {
      return data.keys().hasAll(['id', 'mode', 'examRefId', 'examTitle', 'userId', 'studentId', 'studentName', 'maxMarks', 'evaluationStatus', 'submittedAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'mode', 'examRefId', 'examTitle', 'subjectCode', 'userId', 'studentId', 'studentName', 'studentRegisterNo', 'answerNotes', 'answerFileName', 'answerFileType', 'answerFileDataUrl', 'mcqAnswers', 'autoScore', 'maxMarks', 'passMarks', 'marksObtained', 'grade', 'pass', 'evaluationStatus', 'evaluatorId', 'evaluatorName', 'evaluatorRemarks', 'evaluatedAt', 'mdVerifiedBy', 'mdVerifiedAt', 'mdVerificationRemarks', 'submittedAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.mode in ['ANSWERBOOK', 'MCQ'] &&
             data.examRefId is string && data.examRefId.size() > 0 && data.examRefId.size() <= 128 &&
             data.examTitle is string && data.examTitle.size() > 0 && data.examTitle.size() <= 240 &&
             (!('subjectCode' in data) || (data.subjectCode is string && data.subjectCode.size() <= 50)) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 150 &&
             (!('studentRegisterNo' in data) || (data.studentRegisterNo is string && data.studentRegisterNo.size() <= 64)) &&
             (!('answerNotes' in data) || (data.answerNotes is string && data.answerNotes.size() <= 20000)) &&
             (!('answerFileName' in data) || (data.answerFileName is string && data.answerFileName.size() <= 260)) &&
             (!('answerFileType' in data) || (data.answerFileType is string && data.answerFileType.size() <= 120)) &&
             (!('answerFileDataUrl' in data) || (data.answerFileDataUrl is string && data.answerFileDataUrl.size() <= 500000)) &&
             (!('mcqAnswers' in data) || data.mcqAnswers is map) &&
             (!('autoScore' in data) || (data.autoScore is number && data.autoScore >= 0)) &&
             data.maxMarks is number && data.maxMarks > 0 && data.maxMarks <= 1000 &&
             (!('passMarks' in data) || (data.passMarks is number && data.passMarks >= 0)) &&
             (!('marksObtained' in data) || (data.marksObtained is number && data.marksObtained >= 0 && data.marksObtained <= data.maxMarks)) &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 10)) &&
             (!('pass' in data) || data.pass is bool) &&
             data.evaluationStatus in ['SUBMITTED', 'INSTRUCTOR_EVALUATED', 'MD_VERIFIED', 'RETURNED'] &&
             (!('evaluatorId' in data) || (data.evaluatorId is string && data.evaluatorId.size() <= 128)) &&
             (!('evaluatorName' in data) || (data.evaluatorName is string && data.evaluatorName.size() <= 150)) &&
             (!('evaluatorRemarks' in data) || (data.evaluatorRemarks is string && data.evaluatorRemarks.size() <= 2000)) &&
             (!('evaluatedAt' in data) || (data.evaluatedAt is string && data.evaluatedAt.size() <= 64)) &&
             (!('mdVerifiedBy' in data) || (data.mdVerifiedBy is string && data.mdVerifiedBy.size() <= 150)) &&
             (!('mdVerifiedAt' in data) || (data.mdVerifiedAt is string && data.mdVerifiedAt.size() <= 64)) &&
             (!('mdVerificationRemarks' in data) || (data.mdVerificationRemarks is string && data.mdVerificationRemarks.size() <= 1000)) &&
             data.submittedAt is string && data.submittedAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidExamAnnouncement(data) {
